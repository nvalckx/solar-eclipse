    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.39.2",
    "globals": "16.5.0",
    "playwright": "1.61.1",
    "prettier": "^3.8.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
